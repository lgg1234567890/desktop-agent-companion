# LLM API Configuration (OpenAI-compatible)
# Copy this file to api_config.json and fill in your values

LLM_API_KEY=sk-your-api-key-here
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=glm-5

# Embedding API (for RAG vector store)
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_MODEL=text-embedding-v2

# TTS Configuration (optional)
# Alibaba Cloud CosyVoice (primary)
COSVOICE_API_KEY=sk-your-cosyvoice-key-here
COSVOICE_VOICE_ID=default

# edge-tts (fallback, no key needed)
EDGE_TTS_VOICE=zh-CN-YunjianNeural

# Pet Behavior
PROACTIVE_INTERVAL_SECONDS=60
NIGHT_SILENCE_START=23
NIGHT_SILENCE_END=8
